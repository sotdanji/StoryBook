[
  {
    "start": 0.5,
    "end": 3,
    "text": "어둠이 내려와도\n너와 함께라면 괜찮아"
  },
  {
    "start": 3,
    "end": 6,
    "text": "스치는 바람에도\n네 목소리가 들려와"
  },
  {
    "start": 6,
    "end": 10,
    "text": "오늘도 너를 생각해"
  },
  {
    "start": 10,
    "end": 12.5,
    "text": "밤하늘에 번지는 이 마음"
  },
  {
    "start": 13.5,
    "end": 15.5,
    "text": "시간이 멈춘 것처럼\n너와 걷고 싶은 이 밤"
  },
  {
    "start": 15.5,
    "end": 18,
    "text": "조금 더 가까이 와줘\n지금 이곳에 영원히"
  }
]
