# =====================================================================
# StoryBook Studio 단일 플랫폼 환경 설정 템플릿 (.env.example)
# 본 파일을 복사하여 '.env'로 저장하거나, Fly.io 배포 시 `fly secrets set`으로 주입합니다.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Turso libSQL 상시대기 데이터베이스 (No-Sleep Edge DB — 무료 티어)
# - https://turso.tech 에서 DB 생성 후 URL 및 Token 발급
# - 비워둘 경우 내 PC의 로컬 SQLite(storybook_master.sqlite)로 자동 작동합니다.
# ---------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ---------------------------------------------------------------------
# 2. Cloudflare R2 영구 미디어 스토리지 (다운로드 트래픽 0원 — 무료 10GB)
# - Cloudflare 대시보드 -> R2 -> 버킷 생성 및 API 토큰 발급
# - 비워둘 경우 로컬 projects/ 디렉토리 캐시 모드로 작동합니다.
# ---------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=storybook-media
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ---------------------------------------------------------------------
# 3. Google Gemini AI API Key (창작/퇴고/삽화 기본 키)
# - 웹 사용자는 브라우저(BYOK)에서 본인 키를 직접 등록하여 사용할 수도 있습니다.
# - https://aistudio.google.com/ 에서 무료 발급 가능
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# 4. 부크크(Bookk) 300 DPI 출판 기본 규격 설정
# ---------------------------------------------------------------------
BOOK_TARGET_POEMS=35
BOOK_PAPER_TYPE=white_100g
DEFAULT_ART_STYLE=Korean Ink Watercolor

# ---------------------------------------------------------------------
# 5. 최고 관리자(Admin) 권한 이메일 설정 (쉼표로 구분)
# ---------------------------------------------------------------------
ADMIN_EMAILS=your_admin_email@example.com
