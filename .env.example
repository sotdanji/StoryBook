# =================================================================
# StoryBook Studio 환경 설정 템플릿 (.env.example)
# 본 파일을 복사하여 '.env' 파일로 저장한 뒤 값을 입력하세요.
# =================================================================

# 1. Google Gemini AI API Key (필수 권장)
# - https://aistudio.google.com/ 에서 무료 발급 가능
# - 미입력 시에도 로컬 조판 및 기본 편집기는 정상 동작합니다.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. 책 기본 규격 설정
BOOK_TARGET_POEMS=35
BOOK_PAPER_TYPE=white_100g
DEFAULT_ART_STYLE=Korean Ink Watercolor

# 3. 최고 관리자(Admin) 권한 설정 (쉼표로 구분)
# - 지정된 이메일로 로그인 시 /admin 관리자 대시보드 접근 권한이 부여됩니다.
ADMIN_EMAILS=your_admin_email@example.com

# 4. Supabase 회원 인증 (선택 사항)
# - 클라우드 소셜(구글) 로그인을 활성화하려면 Supabase 프로젝트 키를 입력하세요.
# - 비워둘 경우 로컬 단독(게스트) 모드로 동작합니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 5. 창작자 후원 및 기부 링크 (선택 사항)
# - Buy Me a Coffee, 카카오페이 송금, 토스 아이디 등 후원 링크
DONATION_URL=https://buymeacoffee.com/your_id
